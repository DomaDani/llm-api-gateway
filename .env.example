# Example .env configuration. Modify and copy/rename to .env for use.

# --- Endpoint configuration ---

# TARGET_URL is the URL of the target LLM API endpoint that the gateway will forward requests to.
TARGET_URL=https://mock-upstream:8081/v1

# TARGET_KEY is the API key or token used by the gateway to authenticate with the target LLM API.
TARGET_KEY=key12345

# PROVIDER_ID is an identifier for the upstream provider, used in pricing calculations and logging.
# If using a self-hosted model or a provider not in the genai_prices database, create a unique provider at /shared/config/providers.json and set this to its ID.
# See: https://github.com/pydantic/genai-prices?tab=readme-ov-file#providers
# See: /shared/config/providers.example.json
PROVIDER_ID=selfhosted

# --- Authentication configuration ---

# EXPECTED_KEY_LENGTH is minimum expected length of API keys for basic validation.
EXPECTED_KEY_LENGTH=64

# FINGERPRINT_LENGTH is the number of characters at the start of the API key used for identification.
FINGERPRINT_LENGTH=12

# --- Quota and pricing configuration ---

# QUOTA_STRICTNESS is a multiplier applied to the estimated completion tokens when checking quota, to provide a buffer against under/overestimation.
# For example, a value of 0.5 means we will only count 50% of the max_completion_tokens towards the quota check, allowing for some flexibility.
QUOTA_STRICTNESS=0.5

# DEFAULT_MAX_COMPLETION_TOKENS is the default value for max_completion_tokens if not specified in the request, used for estimating costs and quota.
DEFAULT_MAX_COMPLETION_TOKENS=4096

# DEFAULT_INPUT_MTOKEN_PRICE is the fallback value used for input prices / mtoken if a model not properly configured in genai_prices is successfully called.
# See: https://github.com/pydantic/genai-prices?tab=readme-ov-file#providers
# See: /shared/config/providers.example.json
DEFAULT_INPUT_MTOKEN_PRICE=0.2

# DEFAULT_OUTPUT_MTOKEN_PRICE is the fallback value used for output prices / mtoken if a model not properly configured in genai_prices is successfully called.
# See: https://github.com/pydantic/genai-prices?tab=readme-ov-file#providers
# See: /shared/config/providers.example.json
DEFAULT_OUTPUT_MTOKEN_PRICE=1.1

# --- Database configuration ---

# POSTGRES_USER is the username for the PostgreSQL database, used in the docker-compose setup. This is not used directly in the code but is important for setting up the database container correctly.
POSTGRES_USER=pguser

# POSTGRES_PASSWORD is the password for the PostgreSQL database, used in the docker-compose setup. This is not used directly in the code but is important for setting up the database container correctly.
POSTGRES_PASSWORD=pgpass

# DATABASE_URL is the database connection URL used by SQLAlchemy to connect to the database for logging usage and managing API keys, projects, etc.
# A database container is included in the docker-compose setup, and the URL should be set accordingly (e.g., "postgresql+asyncpg://pguser:pgpass@db:5432/postgres").
# If the database is set up using the database container, the username and password has to match POSTGRES_USER and POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://pguser:pgpass@db:5432/postgres

# --- Dashboard configuration ---

# GATEWAY_HOST is the host interface used when publishing the gateway container port on the Docker host.
GATEWAY_HOST=0.0.0.0

# GATEWAY_PORT is the port published on the Docker host for the gateway container.
GATEWAY_PORT=8000

# DASHBOARD_BACKEND_HOST is the host interface used when publishing the dashboard backend container port on the Docker host.
DASHBOARD_BACKEND_HOST=0.0.0.0

# DASHBOARD_BACKEND_PORT is the port published on the Docker host for the dashboard backend container.
DASHBOARD_BACKEND_PORT=8080

# DASHBOARD_FRONTEND_HOST is the host interface used when publishing the dashboard frontend container port on the Docker host.
DASHBOARD_FRONTEND_HOST=0.0.0.0

# DASHBOARD_FRONTEND_PORT is the port published on the Docker host for the dashboard frontend container.
DASHBOARD_FRONTEND_PORT=5173

# LOGIN_SECRET_KEY is the server side secret key for generating access tokens during login to the dashboard.
LOGIN_SECRET_KEY=secretkey1234

# TOKEN_EXPIRATION_MINS is the amount of time (in minutes) a token is active after login. After this, another login is needed.
TOKEN_EXPIRATION_MINS=30

# TOKEN_ENCODING_ALGORITHM is the algorithm used to encode the secret key and create the login access token.
TOKEN_ENCODING_ALGORITHM=HS256

# FRONTEND_ADDRESS is the address of the frontend domain. This has to be set to allow for proper communication to the backend, which limits connections.
FRONTEND_ADDRESS=https://localhost

# ADMINISTRATOR_USERNAME is the username of the administrator account used for project and user management in the dashboard.
ADMINISTRATOR_USERNAME=Administrator

# ADMINISTRATOR_EMAIL is the email address of the administrator account used for project and user management in the dashboard.
ADMINISTRATOR_EMAIL=admin@example.com

# ADMINISTRATOR_PASSWORD is the password of the administrator account used for project and user management in the dashboard.
ADMINISTRATOR_PASSWORD=password123